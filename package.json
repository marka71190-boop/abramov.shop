{
  "name": "abramov-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/migrate.mjs",
    "db:restore": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/restore.mjs",
    "db:seed": "tsx --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/seed.ts",
    "db:studio": "drizzle-kit studio",
    "db:local": "node scripts/dev-db.mjs"
  },
  "dependencies": {
    "@types/qrcode": "^1.5.5",
    "better-auth": "1.7.7",
    "drizzle-orm": "0.45.4",
    "exceljs": "4.4.0",
    "next": "16.4.0",
    "nodemailer": "^7.0.13",
    "pg": "8.23.1",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sharp": "^0.35.5",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@electric-sql/pglite-socket": "0.2.11",
    "@types/node": "^22",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "0.31.11",
    "esbuild": "^0.25.12",
    "tsx": "^4",
    "typescript": "^5"
  },
  "engines": {
    "node": ">=20.9"
  }
}
