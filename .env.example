# ---------- Обязательные ----------

# Адрес сайта (без слэша в конце)
NEXT_PUBLIC_SITE_URL=https://abramov.shop

# База PostgreSQL (на Timeweb: «Облачные базы данных» → PostgreSQL → строка подключения)
DATABASE_URL=postgresql://user:password@localhost:5432/abramov_shop

# Секрет для входа и подписи cookie. Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=замените-на-случайную-строку
BETTER_AUTH_URL=https://abramov.shop
# Другие адреса, с которых можно входить на сайт, через запятую (например, технический домен Timeweb)
TRUSTED_ORIGINS=

# ---------- Вход через Google ----------
# console.cloud.google.com → APIs & Services → Credentials → OAuth client ID (Web application)
# Authorized redirect URI: https://abramov.shop/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------- Вход через VK ID ----------
# id.vk.com/about/business → «Подключить VK ID» → приложение «Веб-сервис»
# Базовый домен: abramov.shop, доверенный Redirect URL: https://abramov.shop/api/auth/callback/vk
# ID приложения → VK_CLIENT_ID, «Защищённый ключ» → VK_CLIENT_SECRET
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# ---------- Первый администратор ----------
# Кто зарегистрируется с этой почтой — сразу получит права владельца (доступ к админке)
OWNER_EMAIL=oplatyabramovshop@gmail.com

# ---------- Оплата ЮKassa ----------
# yookassa.ru → Интеграция → Ключи API. Тестовый магазин: ключ начинается с test_
# Адрес для уведомлений (HTTP-уведомления): https://abramov.shop/api/payments/yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# true — отправлять чеки 54-ФЗ (если подключены «Чеки от ЮKassa»)
YOOKASSA_SEND_RECEIPT=false
# Ставка НДС в чеке: 1 — без НДС
YOOKASSA_VAT_CODE=1

# ---------- Доставка СДЭК ----------
# lk.cdek.ru → Интеграция → Ключи API. Город отправки, ПВЗ и тарифы — в админке → Настройки
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# true — учебная среда api.edu.cdek.ru (отправления ненастоящие)
CDEK_TEST_MODE=false
