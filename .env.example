# ---------- Обязательные ----------

# Адрес сайта (без слэша в конце)
NEXT_PUBLIC_SITE_URL=https://abramov.shop

# База PostgreSQL (на Timeweb: «Облачные базы данных» → PostgreSQL → строка подключения)
DATABASE_URL=postgresql://user:password@localhost:5432/abramov_shop

# Секрет для входа и подписи cookie. Сгенерировать: openssl rand -base64 32
BETTER_AUTH_SECRET=замените-на-случайную-строку
BETTER_AUTH_URL=https://abramov.shop
# Другие адреса, с которых можно входить на сайт, через запятую (например, технический домен Timeweb)
TRUSTED_ORIGINS=

# ---------- Google: вход через Google и Google Диск для фото и видео проверки товаров ----------
# console.cloud.google.com → APIs & Services → Library → Google Drive API → Enable
# Credentials → OAuth client ID (Web application), Authorized redirect URIs:
#   https://abramov.shop/api/auth/callback/google      (вход через Google)
#   https://abramov.shop/api/google/drive/callback     (Google Диск)
# OAuth consent screen: External, статус «In production». После — админка → Настройки → Google Диск → «Подключить»
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Кнопка «Войти через Google» для покупателей — только с этой переменной (для Google Диска не нужна)
# GOOGLE_LOGIN=true
# Только если сервер не достаёт до Google — релей (см. relay/README.md):
# GOOGLE_API_URL=https://<воркер>.workers.dev/<RELAY_KEY>/g
# GOOGLE_TOKEN_URL=https://<воркер>.workers.dev/<RELAY_KEY>/oauth/token

# ---------- Вход через VK ID ----------
# id.vk.com/about/business → «Подключить VK ID» → приложение «Веб-сервис»
# Базовый домен: abramov.shop, доверенный Redirect URL: https://abramov.shop/api/auth/callback/vk
# ID приложения → VK_CLIENT_ID, «Защищённый ключ» → VK_CLIENT_SECRET
VK_CLIENT_ID=
VK_CLIENT_SECRET=

# ---------- Первый администратор ----------
# Кто зарегистрируется с этой почтой — сразу получит права владельца (доступ к админке)
OWNER_EMAIL=oplatyabramovshop@gmail.com

# ---------- Оплата ЮKassa ----------
# yookassa.ru → Интеграция → Ключи API. Тестовый магазин: ключ начинается с test_
# Адрес для уведомлений (HTTP-уведомления): https://abramov.shop/api/payments/yookassa
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
# true — отправлять чеки 54-ФЗ (если подключены «Чеки от ЮKassa»)
YOOKASSA_SEND_RECEIPT=false
# Ставка НДС в чеке: 1 — без НДС
YOOKASSA_VAT_CODE=1

# ---------- Доставка СДЭК ----------
# lk.cdek.ru → Интеграция → Ключи API. Город отправки, ПВЗ и тарифы — в админке → Настройки
CDEK_CLIENT_ID=
CDEK_CLIENT_SECRET=
# true — учебная среда api.edu.cdek.ru (отправления ненастоящие)
CDEK_TEST_MODE=false

# ---------- Telegram-бот ----------
# @BotFather → /newbot → токен. Адрес для сообщений сайт регистрирует сам при старте
TELEGRAM_BOT_TOKEN=
# Релей до api.telegram.org — если сервер в России не достаёт до Telegram (см. relay/README.md)
TELEGRAM_API_URL=

# ---------- Почта (восстановление пароля, письма о заказах) ----------
# Почта в России (152-ФЗ): ящик Timeweb на домене. Gmail не используем — это передача данных в США
SMTP_HOST=smtp.timeweb.ru
SMTP_PORT=465
SMTP_USER=shop@abramov.shop
SMTP_PASS=
SMTP_FROM=Abramov Shop <shop@abramov.shop>
# Рассылки (админка → Рассылки): писем в минуту и писем рассылок в сутки. У Gmail лимит ~500 писем в день
MAIL_PER_MINUTE=20
MAIL_DAILY_LIMIT=450

# ---------- Яндекс Метрика ----------
# metrika.yandex.ru → «Добавить счётчик» → сайт abramov.shop, включите вебвизор и «Электронная коммерция» (контейнер dataLayer).
# Номер счётчика (только цифры). Счётчик грузится лишь у тех, кто нажал «Принять» в плашке о cookie
YANDEX_METRIKA_ID=
